{
    "name": "vinylwave/vinylwave-project",
    "description": "VINYLWAVE - Vinyl records, merch, singles and DVD shop",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Controllers\\": "controllers/",
            "Models\\": "models/",
            "Config\\": "config/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}